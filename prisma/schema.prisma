generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Clinician {
  id           String   @id @default(uuid())
  organisationId String?
  fullName     String
  email        String   @unique
  passwordHash String
  role         String
  permissions  String[] @default([])
  status       String   @default("active")
  twoFactorEnabled Boolean @default(false)
  twoFactorSecretEncrypted String?
  mustResetPassword Boolean @default(false)
  passwordUpdatedAt DateTime?
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())

  organisation     Organisation? @relation(fields: [organisationId], references: [id])
  patientsCreated Patient[] @relation("PatientsCreated")
  assessments      WoundAssessment[]
  auditLogs        AuditLog[]
  accessApprovals  AccessRequest[] @relation("AccessRequestApprovedBy")
  incompleteFreshAssessments IncompleteFreshAssessment[]
  invitationsSent  Invitation[] @relation("InvitationInvitedBy")
  supportGrantsApproved SupportAccessGrant[] @relation("SupportGrantApprovedBy")

  @@index([organisationId, status])
}

model Organisation {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  status      String   @default("active")
  plan        String   @default("demo")
  planTier    String?
  subscriptionStatus String @default("trial")
  subscriptionInterval String?
  subscriptionMode String?
  paymentMethod String?
  currentPeriodStart DateTime?
  currentPeriodEnd DateTime?
  billingEmail String?
  billingCustomerRef String?
  seatsAllowed Int?
  features String[] @default([])
  ownerEmail  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clinicians                 Clinician[]
  accessRequests             AccessRequest[]
  incompleteFreshAssessments IncompleteFreshAssessment[]
  patients                   Patient[]
  wounds                     Wound[]
  photos                     WoundPhoto[]
  assessments                WoundAssessment[]
  carePlans                  CarePlan[]
  reports                    Report[]
  auditLogs                  AuditLog[]
  invitations                Invitation[]
  announcements              Announcement[]
  supportAccessGrants        SupportAccessGrant[]
  billingRecords             BillingRecord[]

  @@index([status, createdAt])
  @@index([subscriptionStatus, updatedAt])
}

model Invitation {
  id             String   @id @default(uuid())
  organisationId String
  email          String
  fullName       String?
  role           String   @default("clinician")
  permissions    String[] @default([])
  tokenHash      String   @unique
  status         String   @default("pending")
  expiresAt      DateTime
  invitedById    String?
  acceptedAt     DateTime?
  createdAt      DateTime @default(now())

  tenant    Organisation @relation(fields: [organisationId], references: [id])
  invitedBy Clinician? @relation("InvitationInvitedBy", fields: [invitedById], references: [id])

  @@index([organisationId, status, createdAt])
  @@index([email, status])
}

model Announcement {
  id             String   @id @default(uuid())
  organisationId String?
  title          String
  body           String
  audience       String   @default("all")
  status         String   @default("draft")
  publishedAt    DateTime?
  createdAt      DateTime @default(now())

  tenant Organisation? @relation(fields: [organisationId], references: [id])

  @@index([organisationId, status, createdAt])
}

model SupportAccessGrant {
  id             String   @id @default(uuid())
  organisationId String
  reason         String
  status         String   @default("requested")
  approvedById   String?
  startsAt       DateTime?
  expiresAt      DateTime?
  createdAt      DateTime @default(now())

  tenant     Organisation @relation(fields: [organisationId], references: [id])
  approvedBy Clinician? @relation("SupportGrantApprovedBy", fields: [approvedById], references: [id])

  @@index([organisationId, status, expiresAt])
}

model BillingRecord {
  id             String   @id @default(uuid())
  organisationId String
  periodStart    DateTime?
  periodEnd      DateTime?
  amount         String?
  currency       String   @default("GBP")
  planTier       String?
  billingInterval String?
  subscriptionMode String?
  paymentMethod  String?
  paymentReference String?
  status         String   @default("draft")
  externalRef    String?
  confirmationSource String?
  confirmedAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())

  tenant Organisation @relation(fields: [organisationId], references: [id])

  @@index([organisationId, status, createdAt])
}

model AccessRequest {
  id             String   @id @default(uuid())
  organisationId String?
  fullName       String
  email          String
  roleRequested  String?
  organisation   String?
  message        String?
  status         String   @default("pending")
  reviewedAt     DateTime?
  reviewedById   String?
  reviewNote     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant     Organisation? @relation(fields: [organisationId], references: [id])
  reviewedBy Clinician? @relation("AccessRequestApprovedBy", fields: [reviewedById], references: [id])

  @@unique([email, status])
  @@index([organisationId, status, createdAt])
  @@index([status, createdAt])
}

model IncompleteFreshAssessment {
  id              String   @id @default(uuid())
  organisationId  String?
  patientLocalId  String
  clinicianId     String?
  clinicianName   String?
  clinicianRole   String?
  patientName     String
  nhsNumber       String?
  pendingStep     String   @default("Wound capture and assessment")
  woundSite       String?
  source          String   @default("Incomplete fresh assessment")
  status          String   @default("open")
  payload         Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Organisation? @relation(fields: [organisationId], references: [id])
  clinician Clinician? @relation(fields: [clinicianId], references: [id])

  @@index([organisationId, status, updatedAt])
  @@index([clinicianId, status, updatedAt])
  @@index([status, updatedAt])
}

model Patient {
  id                 String   @id @default(uuid())
  organisationId     String?
  nhsNumber          String?
  hospitalNumber     String?
  title              String?
  fullName           String
  dateOfBirth        DateTime?
  age                String?
  sex                String?
  gender             String?
  maritalStatus      String?
  ethnicity          String?
  allergyStatus      String?
  diabetesStatus     String?
  pastMedicalHistory String?
  currentWoundHistory String?
  mobilityStatus     String?
  vascularRisk       String?
  nutritionRisk      String?
  pressureInjuryRisk String?
  careSetting        String?
  photoConsentStatus String?
  clinicalConsentStatus String?
  consentScope       String[] @default([])
  consentRecordedAt  DateTime?
  privacyPolicyAcceptedAt DateTime?
  termsAcceptedAt    DateTime?
  governanceChecks   String[] @default([])
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  tenant    Organisation? @relation(fields: [organisationId], references: [id])
  createdBy Clinician? @relation("PatientsCreated", fields: [createdById], references: [id])
  wounds    Wound[]
  auditLogs AuditLog[]

  @@index([organisationId, updatedAt])
}

model Wound {
  id                    String   @id @default(uuid())
  organisationId         String?
  patientId             String
  woundSite             String
  woundType             String?
  cause                 String?
  currentDressing       String?
  reviewFrequency       String?
  responsibleClinician  String?
  presentMedicalHistory String?
  onsetDate             DateTime?
  careCommencedDate     DateTime?
  nextReviewDate        DateTime?
  status                String   @default("pending assessment")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant      Organisation?     @relation(fields: [organisationId], references: [id])
  patient     Patient           @relation(fields: [patientId], references: [id])
  photos      WoundPhoto[]
  assessments WoundAssessment[]
  carePlans   CarePlan[]
  reports     Report[]
  auditLogs   AuditLog[]

  @@index([organisationId, status, nextReviewDate])
  @@index([organisationId, updatedAt])
}

model WoundPhoto {
  id            String   @id @default(uuid())
  organisationId String?
  woundId       String
  assessmentId  String?
  storageKey    String
  bodyMapView   String?
  bodyMapX      Float?
  bodyMapY      Float?
  woundPointData Json?
  flashlightUsed Boolean  @default(false)
  consentStatus String
  encryptionStatus String @default("private encrypted storage required")
  capturedById  String?
  capturedAt    DateTime @default(now())

  tenant     Organisation?     @relation(fields: [organisationId], references: [id])
  wound      Wound            @relation(fields: [woundId], references: [id])
  assessment WoundAssessment? @relation(fields: [assessmentId], references: [id])

  @@index([organisationId, capturedAt])
}

model WoundAssessment {
  id                         String   @id @default(uuid())
  organisationId             String?
  woundId                    String
  clinicianId                String?
  assessedAt                 DateTime @default(now())
  measurementMethod          String?
  lengthCm                   Float?
  widthCm                    Float?
  depthCm                    Float?
  areaCm2                    Float?
  tunnelling                 Boolean  @default(false)
  rolledEdge                 Boolean  @default(false)
  undermining                Boolean  @default(false)
  sinusTract                 Boolean  @default(false)
  cavity                     Boolean  @default(false)
  pocketing                  Boolean  @default(false)
  granulationPercent         Float?
  sloughPercent              Float?
  necrosisPercent            Float?
  epithelialisationPercent   Float?
  exudateType                String?
  exudateAmount              String?
  odor                       String?
  periwoundFindings          String[] @default([])
  infectionSigns             String[] @default([])
  edgeCondition              String?
  painScore                  Float?
  pressureInjuryCategory     String?
  healingStatus              String?
  escalationRequired         Boolean  @default(false)
  flags                      String[] @default([])
  clinicalNote               String?

  tenant    Organisation? @relation(fields: [organisationId], references: [id])
  wound     Wound      @relation(fields: [woundId], references: [id])
  clinician Clinician? @relation(fields: [clinicianId], references: [id])
  carePlans CarePlan[]
  reports   Report[]
  photos    WoundPhoto[]

  @@index([organisationId, assessedAt])
  @@index([organisationId, escalationRequired])
}

model CarePlan {
  id                       String   @id @default(uuid())
  organisationId           String?
  woundId                  String
  assessmentId             String?
  primaryDressing          String?
  secondaryDressing        String?
  compressionMeasurements  String?
  solutionUsed             String?
  actionsRequired          String[] @default([])
  escalationInstructions   String?
  dressingChangeFrequency  String?
  nextReviewDate           DateTime?
  timeSpent                String?
  pressureInjuryCategory   String?
  mobilityAssessment       String?
  repositioningPrompt      String?
  assistiveAids            String[] @default([])
  garments                 String[] @default([])
  continenceAssessment     String?
  padChangeFrequency       String?
  lastBowelMovement        String?
  stoolAssessment          String?
  hygiene                  String?
  nutrition                String?
  hydration                String?
  weight                   String?
  height                   String?
  bmi                      String?
  createdAt                DateTime @default(now())

  tenant     Organisation?     @relation(fields: [organisationId], references: [id])
  wound      Wound            @relation(fields: [woundId], references: [id])
  assessment WoundAssessment? @relation(fields: [assessmentId], references: [id])

  @@index([organisationId, createdAt])
}

model Report {
  id           String   @id @default(uuid())
  organisationId String?
  woundId      String
  assessmentId String?
  reportText   String
  sentVia      String?
  sentTo       String?
  mdtShareStatus String?
  pdfGeneratedAt DateTime?
  sentAt       DateTime?
  createdAt    DateTime @default(now())

  tenant     Organisation?     @relation(fields: [organisationId], references: [id])
  wound      Wound            @relation(fields: [woundId], references: [id])
  assessment WoundAssessment? @relation(fields: [assessmentId], references: [id])

  @@index([organisationId, createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  organisationId String?
  clinicianId String?
  patientId   String?
  woundId     String?
  action      String
  details     String?
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant    Organisation? @relation(fields: [organisationId], references: [id])
  clinician Clinician? @relation(fields: [clinicianId], references: [id])
  patient   Patient?   @relation(fields: [patientId], references: [id])
  wound     Wound?     @relation(fields: [woundId], references: [id])

  @@index([organisationId, createdAt])
}
