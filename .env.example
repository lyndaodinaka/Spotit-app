NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://spotit:spotit_password@localhost:5432/spotit
JWT_SECRET=replace_with_long_random_secret
FIELD_ENCRYPTION_KEY=replace_with_32_byte_base64_key
SESSION_TIMEOUT_HOURS=8
PHOTO_STORAGE_BUCKET=spotit-wound-photos-private
PHOTO_STORAGE_REGION=uk-region
PHOTO_STORAGE_ENCRYPTION=private-server-side-encryption
APP_BASE_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:4000
ADMIN_NAME=Spotit Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_12_character_password
ADMIN_ROLE=platform_admin
ADMIN_ORGANISATION_NAME=Medholic Digital Health
ADMIN_ORGANISATION_SLUG=medholic-digital-health
BACKUP_POLICY=railway_postgres_managed_backups_enabled
SPOTIT_SMALL_MONTHLY_GBP=800.00
SPOTIT_SMALL_YEARLY_GBP=8800.00
SPOTIT_MEDIUM_MONTHLY_GBP=1500.00
SPOTIT_MEDIUM_YEARLY_GBP=16500.00
SPOTIT_LARGE_MONTHLY_GBP=3000.00
SPOTIT_LARGE_YEARLY_GBP=33000.00
SPOTIT_ENTERPRISE_MONTHLY_GBP=Custom quotation
SPOTIT_ENTERPRISE_YEARLY_GBP=Custom quotation
SPOTIT_BANK_ACCOUNT_NAME=Medholic Digital Health
SPOTIT_BANK_SORT_CODE=replace_with_business_sort_code
SPOTIT_BANK_ACCOUNT_NUMBER=replace_with_business_account_number
SPOTIT_BANK_IBAN=optional_for_international_payments
SPOTIT_BANK_BIC=optional_for_international_payments
SPOTIT_BANK_REFERENCE_PREFIX=SPOTIT
ACCESS_REQUEST_OWNER_EMAIL=lynda.chidi@medholic.net
ACCESS_REQUEST_FROM_EMAIL=Spotit Access <onboarding@resend.dev>
RESEND_API_KEY=replace_with_resend_api_key_for_email_notifications
NHS_API_BASE_URL=https://sandbox.api.service.nhs.uk/personal-demographics/FHIR/R4
NHS_PDS_ACCESS_MODE=sandbox-open-access
NHS_API_KEY=replace_after_nhs_onboarding_for_integration_or_production
NHS_CLIENT_ID=replace_after_nhs_onboarding_if_required
NHS_CLIENT_SECRET=replace_after_nhs_onboarding_if_required
